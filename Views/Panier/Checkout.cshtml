@model atelier2.ViewModels.OrderViewModel

@{
    ViewData["Title"] = "Finaliser la Commande";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header card-header-blue">
                <h3 class="card-title mb-0">
                    <i class="fas fa-shopping-bag me-2"></i>@ViewData["Title"]
                </h3>
            </div>
            <div class="card-body">
                <!-- Résumé de la commande -->
                <div class="mb-4">
                    <h5 class="mb-3 text-blue-gradient">
                        <i class="fas fa-receipt me-2"></i>Résumé de votre commande
                    </h5>

                    @if (Model?.CartItems == null || !Model.CartItems.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>Votre panier est vide.
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div>
                                    <h6 class="mb-1">@item.ProductName</h6>
                                    <small class="text-muted">Quantité: @item.Quantity</small>
                                </div>
                                <span class="text-blue fw-bold">@((item.Price * item.Quantity).ToString("C"))</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                            <h5 class="mb-0">Total:</h5>
                            <h4 class="text-blue mb-0">@Model.TotalAmount.ToString("C")</h4>
                        </div>
                    }
                </div>

                <!-- Formulaire d'adresse -->
                <form asp-action="Checkout" method="post">
                    <div class="form-group mb-3">
                        <label asp-for="Address" class="form-label fw-bold text-blue">
                            <i class="fas fa-map-marker-alt me-2"></i>Adresse de livraison
                        </label>
                        <textarea asp-for="Address" class="form-control" rows="3"
                                  placeholder="Entrez votre adresse complète de livraison"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                            <i class="fas fa-arrow-left me-1"></i>Retour au panier
                        </a>

                        @if (Model?.CartItems != null && Model.CartItems.Any())
                        {
                            <button type="submit" class="btn btn-order btn-lg">
                                <i class="fas fa-check-circle me-2"></i>Confirmer la commande
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-lg" disabled>
                                <i class="fas fa-ban me-2"></i>Panier vide
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}