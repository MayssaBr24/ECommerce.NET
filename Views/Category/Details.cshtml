@model atelier2.Models.Category

@{
    ViewData["Title"] = "Détails de la Catégorie";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header card-header-blue">
                <h3 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>@ViewData["Title"]
                </h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <h5 class="text-blue mb-3">Informations de la catégorie</h5>
                    <div class="detail-item">
                        <span class="detail-label fw-bold text-blue">ID :</span>
                        <span class="detail-value">@Model.CategoryId</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label fw-bold text-blue">Nom :</span>
                        <span class="detail-value">@Model.CategoryName</span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-outline-warning">
                        <i class="fas fa-edit me-1"></i>Modifier
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>