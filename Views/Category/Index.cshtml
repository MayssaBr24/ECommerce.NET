@model IEnumerable<atelier2.Models.Category>

@{
    ViewData["Title"] = "Gestion des Catégories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-blue-gradient">
        <i class="fas fa-tags me-2"></i>@ViewData["Title"]
    </h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Nouvelle Catégorie
    </a>
</div>

<div class="card">
    <div class="card-header card-header-blue">
        <h5 class="card-title mb-0">
            <i class="fas fa-list me-2"></i>Liste des Catégories
        </h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>
                            <i class="fas fa-tag me-1"></i>Nom de la Catégorie
                        </th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-primary">@Html.DisplayFor(modelItem => item.CategoryName)</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId"
                                       class="btn btn-outline-warning">
                                        <i class="fas fa-edit me-1"></i>Modifier
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.CategoryId"
                                       class="btn btn-outline-info">
                                        <i class="fas fa-eye me-1"></i>Détails
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.CategoryId"
                                       class="btn btn-outline-danger">
                                        <i class="fas fa-trash me-1"></i>Supprimer
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>